{
  "name": "ada-py-viewer",
  "version": "0.70.0",
  "type": "module",
  "workspaces": [
    "packages/plugins/*"
  ],
  "overrides": {
    "qs": ">=6.15.2",
    "esbuild": "$esbuild",
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.3.2"
  },
  "scripts": {
    "gen:plugins": "node scripts/gen-plugin-registry.mjs",
    "prebuild": "node clean.cjs",
    "build": "vite build --emptyOutDir && node embed-script.cjs",
    "build:serve": "vite build --config vite.config.serve.ts --emptyOutDir",
    "build:embed": "vite build --config vite.config.embed.ts",
    "dev": "vite --force",
    "check:seam": "node scripts/check-capability-seam.mjs",
    "pretest": "npm run check:seam",
    "test": "node --import tsx --test \"src/__tests__/**/*.test.ts\" \"src/__tests__/**/*.test.tsx\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/node": "22.13.10",
    "@types/pako": "2.0.3",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@types/three": "0.176.0",
    "@vitejs/plugin-react": "4.3.4",
    "@xyflow/react": "12.4.4",
    "archiver": "6.0.2",
    "camera-controls": "2.10.1",
    "comlink": "4.4.2",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "dexie": "4.0.11",
    "esbuild": "0.28.1",
    "esbuild-helpers": "2.0.1",
    "flatbuffers": "25.2.10",
    "lodash": ">=4.18.0",
    "pako": "2.1.0",
    "postcss": "^8.5.26",
    "prettier": "3.5.3",
    "qs": ">=6.15.2",
    "react": "19.1.0",
    "react-arborist": "3.4.3",
    "react-dom": "19.1.0",
    "react-json-view-lite": "2.4.1",
    "react-rnd": "10.5.2",
    "tailwindcss": "^4.3.0",
    "three": "0.176.0",
    "tsx": "^4.22.4",
    "typescript": "5.8.2",
    "urdf-loader": "0.12.4",
    "vite": "^6.4.3",
    "zustand": "5.0.3"
  },
  "dependencies": {
    "meshoptimizer": "^1.1.1"
  }
}
