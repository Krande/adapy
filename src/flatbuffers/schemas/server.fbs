include "base.fbs";
include "commands.fbs";

namespace server;

table ServerProcessInfo {
  pid: int;
  thread_id: int;
  log_file_path: string;
}

// SAVE_PROCEDURAL_MODEL request payload (ws/REST parity plan, step 3). The
// document rides as JSON text -- the schema wire type, not a re-encoding of
// every procedural doc field -- so the wire contract doesn't have to track
// the document's own evolution. ``model_id`` is an opaque token the client
// invents; it is never a file path. ``expected_content_hash`` is the
// sha256 hex digest of the bytes the client last read for this model_id;
// absent/empty means "no concurrency check, just write" (first save, or a
// model with no local conflict history yet).
table ProceduralModelSave {
  model_id: string;
  doc_json: string;
  expected_content_hash: string;
}

// SAVE_PROCEDURAL_MODEL reply payload: the content hash of what is now on
// disk, so the caller can pass it back as ``expected_content_hash`` on the
// next save.
table ProceduralModelSaveReply {
  model_id: string;
  content_hash: string;
}

// LIST_PROCEDURAL_MODELS takes no request payload -- like LIST_PROCEDURES and
// LIST_FILE_OBJECTS, the command_type alone selects the handler in
// default_on_message. It lists every document under the same directory
// SAVE_PROCEDURAL_MODEL writes into.

// One entry in a LIST_PROCEDURAL_MODELS reply. ``modified_at`` is the file's
// mtime as Unix milliseconds (integer, like ``WebClient.last_heartbeat``
// above, and precise at this magnitude in a way a 32-bit ``float`` would not
// be) -- a browser sorts/displays by it, it is never used as a concurrency
// token (that is ``content_hash``, same as save/load).
table ProceduralModelListEntry {
  model_id: string;
  content_hash: string;
  modified_at: long;
  size_bytes: long;
}

table ProceduralModelListReply {
  entries: [ProceduralModelListEntry];
}

// LOAD_PROCEDURAL_MODEL request payload: the same opaque ``model_id`` token
// SAVE_PROCEDURAL_MODEL takes, validated and path-contained the same way.
table ProceduralModelLoad {
  model_id: string;
}

// LOAD_PROCEDURAL_MODEL reply payload: the document as it is on disk, plus
// its content hash so the caller can thread it back as
// ``expected_content_hash`` on its next save (same contract SAVE_PROCEDURAL_MODEL's
// reply already gives a saver).
table ProceduralModelLoadReply {
  model_id: string;
  doc_json: string;
  content_hash: string;
}

// REGISTER_FEA_SOURCE request payload. ``bake_dir`` is a directory on the
// server's machine holding an FEA artefact bake (fea.manifest.json and the
// files it names); only the local process that wrote it sends this. A
// ``source_key`` registered again points at the new bake. ``bake_id`` changes
// whenever the bake does, so a viewer can tell a re-shown result from the one
// it already holds. ``open_in_viewer`` pushes OPEN_FEA_SOURCE to every
// connected viewer once the source is registered.
table FeaSourceRegister {
  source_key: string;
  bake_dir: string;
  bake_id: string;
  open_in_viewer: bool;
}

// OPEN_FEA_SOURCE payload (server -> web), and the REGISTER_FEA_SOURCE reply.
table FeaSourceInfo {
  source_key: string;
  bake_id: string;
}

// GET_FEA_MANIFEST request payload.
table FeaManifestRequest {
  source_key: string;
}

// GET_FEA_MANIFEST reply payload: the bake's fea.manifest.json, as text.
table FeaManifestReply {
  source_key: string;
  bake_id: string;
  manifest_json: string;
}

// GET_FEA_BLOB request payload. ``filename`` is manifest-relative, exactly as
// the manifest names it (``fea.mesh.glb``, ``fea.U.bin``, ...); the server
// refuses anything that resolves outside the bake directory. With ``ranged``,
// only bytes ``start``..``end`` (inclusive) are sent -- one step of a field.
table FeaBlobRequest {
  source_key: string;
  filename: string;
  ranged: bool;
  start: long;
  end: long;
}

// GET_FEA_BLOB reply payload. ``ranged`` says whether ``data`` is the asked-for
// window (true) or the whole file; ``total_size`` is the file's size either way.
table FeaBlobReply {
  source_key: string;
  filename: string;
  data: [ubyte];
  ranged: bool;
  total_size: long;
}

// CALL_KERNEL request payload. ``function`` names a kernel the server whitelists
// (ada.comms.msg_handling.kernel_calls); ``args_json`` its arguments; ``data`` the
// binary inputs, laid out as ``args_json`` describes (typed arrays back to back).
table KernelCall {
  function: string;
  args_json: string;
  data: [ubyte];
}

// CALL_KERNEL reply payload. ``result_json`` describes the outputs -- scalars, and
// for each output array its dtype and where it sits in ``data``.
table KernelReply {
  function: string;
  result_json: string;
  data: [ubyte];
}

table ServerReply {
  message: string;
  file_objects: [base.FileObject];
  reply_to: commands.CommandType;
  error: base.Error;
  process_info: ServerProcessInfo;
  save_procedural_model: ProceduralModelSaveReply;
  list_procedural_models: ProceduralModelListReply;
  load_procedural_model: ProceduralModelLoadReply;
  fea_source: FeaSourceInfo;
  fea_manifest: FeaManifestReply;
  fea_blob: FeaBlobReply;
  kernel: KernelReply;
}

table Server {
    new_file_object: base.FileObject;
    all_file_objects: [base.FileObject];
    get_file_object_by_name: string;
    get_file_object_by_path: string;
    delete_file_object: base.FileObject;
    start_file_in_local_app: base.FileObject;
    save_procedural_model: ProceduralModelSave;
    load_procedural_model: ProceduralModelLoad;
    register_fea_source: FeaSourceRegister;
    open_fea_source: FeaSourceInfo;
    fea_manifest_request: FeaManifestRequest;
    fea_blob_request: FeaBlobRequest;
    kernel_call: KernelCall;
}