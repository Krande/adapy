# syntax=docker/dockerfile:1.7
#
# Zensical docs site for adapy. Build stage runs the ``docs`` pixi env:
# the FEA verification report bundle (scripts/docs/fea_report_cached.py →
# ``docs/_static/fea-report/``), the executed notebooks
# (``docs-notebooks``, scripts/docs/docs_notebooks.py) and ``zensical build``
# (mkdocstrings imports ``ada`` from src/); runtime stage serves ``site/``
# via nginx-unprivileged on :8080.
#
# Triggered by docs/**, zensical.toml, verification/**, pixi.toml/lock,
# this Dockerfile, or the workflow itself — see the ``docs`` filter in
# .forgejo/workflows/build.yaml.

ARG PIXI_VERSION=0.81.0
# CI passes --build-arg IMAGE_TAG=sha-XXXXXXX; it labels the image.
# Defaults to "dev" for local builds.
ARG IMAGE_TAG=dev

# `docs-env` = the heavy, source-independent base: the headless-browser
# GUI + wgpu/Vulkan apt closure plus the solved `docs` pixi env. It's
# split into its own stage so CI can publish it as a reusable base image
# that Dockerfile.docs-fast FROMs — a source-only docs change then skips
# this whole stage and just re-runs fea-doc + zensical. Building the full
# image here still produces an identical result (the split is a no-op for
# the final image).
FROM ghcr.io/prefix-dev/pixi:${PIXI_VERSION} AS docs-env

# The Forgejo runner's build sandbox blocks plain-HTTP egress, so
# rewrite the deb822 mirror URLs to https before fetching the
# headless-browser GUI closure (matches our other build
# Dockerfiles' pattern).
#
# BuildKit cache mounts on /var/cache/apt + /var/lib/apt persist the
# downloaded .debs (140 s of installs for the headless-browser GUI
# closure: libnss3, libcups2, etc.) across base-image bumps. The
# default docker-clean apt hook wipes the cache, so disable it first
# — without that the mount is empty on every run. Drop the trailing
# ``rm -rf /var/lib/apt/lists/*`` for the same reason: the mount
# IS the cache, no need to scrub it inside the layer (the cache
# directory isn't copied into the image).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/*.sources \
    && PKGS="ca-certificates \
        libnss3 libatk-bridge2.0-0 libcups2 libxcomposite1 libxdamage1 \
        libxfixes3 libxrandr2 libgbm1 libxkbcommon0 libpango-1.0-0 libcairo2 \
        libasound2t64 \
        mesa-vulkan-drivers libvulkan1" \
    # The Ubuntu archive hosts have failed to resolve from CI runners for hours at a time. When they
    # do, the same archive is taken from another mirror (packages are verified against Ubuntu's keys
    # whichever mirror serves them).
    && { { apt-get update && apt-get install -y --no-install-recommends $PKGS; } \
        || { sed -i 's|https://archive.ubuntu.com|https://mirrors.kernel.org|g; s|https://security.ubuntu.com|https://mirrors.kernel.org|g' /etc/apt/sources.list.d/*.sources \
            && apt-get update && apt-get install -y --no-install-recommends $PKGS; }; }

WORKDIR /work/adapy

# Solve the docs env first — fat closure (prod + desktop + fem-deps +
# tests-core + zensical/mkdocstrings) dominates the cold build. Cache the layer
# across source-only edits by COPYing manifests separately, and
# persist the conda package cache via a BuildKit mount so the first
# build after a base bump doesn't re-download ~500 MB of channels
# every time.
COPY pixi.toml pixi.lock pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/rattler,sharing=locked \
    --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pixi install --environment docs --locked

# The FEA verification report's compile-time stack (paradoc) comes from the
# conda-forge ``paradoc`` package in the ``docs`` pixi env (pinned ``>=0.6.0`` in
# pixi.toml) — no external clone, no build-time secret. ``fea-doc`` invokes
# ``python -m paradoc.cli_app`` directly from that env.
#
# Capabilities the report depends on (current as of paradoc f99b6c0 +
# adapy c6d41f43):
#   * FEA edge segments rendered (camera layer 1 + GLB-direct reader
#     in pygfx_offscreen_utils — `mode: 1` LINES respected the way
#     Three.js does, no more trimesh-Path3D mis-interpretation)
#   * Offscreen poster framing math ported verbatim from
#     `embed/index.ts:applyCameraPreset` (azimuth/elevation/distance/
#     margin) so the poster and live viewer line up to the pixel
#   * Embed `showControls` exposes SimulationControls (mode slider,
#     deformation scale, play/pause for animated GLBs)
#   * Viewer keyboard shortcuts bundled + scoped to the mount
#   * IndexedDB 4→5 bump + per-docId auto-invalidation:
#     DocManifest carries `published_at` so `fetchManifest` wipes
#     cached sections / images / plots / tables / 3d-meta whenever
#     it changes — bundle rebuild needs no Clear-cache click.
#   * DocManifest now also carries the full `git` block (branch,
#     short_commit, full commit, dirty flag, remote URL); About
#     panel surfaces it in embed/static mode where there's no
#     /api/info to query.
# rebuilt frontend.zip with the cog menu / dark mode / landing page /
# scoped embed CSS / h-dvh / clean static-mode topbar; pygfx 0.16 +
# wgpu-py 0.31 + rendercanvas 2.6 pins matching adapy's own bump so
# the FEA report's edge-aware offscreen poster renderer (now using
# `rendercanvas.offscreen.OffscreenRenderCanvas` in both adapy
# helpers — generic and edge-aware) actually runs at build time.
#   * Filter / DbManager / ThreeDView API
#   * Vendored ada-viewer (Z-up, CameraControls refresh, embed CSS now
#     `@scope (.ada-viewer-scope)` so it no longer leaks into host
#     pages — adapy commits 7fdb6506 + 493dd9f6)
#   * static-export presets.json wiring, canvas-fits-container fix,
#     mobile-drawer translate-x + h-dvh fix, single-flight signIn,
#     `${ key }` substitution syntax (the legacy `{{__key__}}` form
#     now emits a deprecation warning on every compile)
#   * Bundle manifest v2 — `published_at` + git provenance baked in at
#     compile time so the landing page can render `branch@short_sha`
#   * `/api/docs/{id}/files/{path}` route + auth-aware AsyncImage —
#     plain `![](files/x.png)` markdown refs in the report no longer
#     need the IndexedDB-embedding round-trip.
#   * Static export ships images as files (not a 10 MB base64
#     `images.json`): absolute build-container paths get flattened to
#     `_images/<sha8>-<basename>` and the bundle's Image srcs are
#     rewritten in-place. `<img loading="lazy">` lets the browser
#     defer off-screen fetches; replaces the legacy bulk preload that
#     gated first paint at ~2 s desktop / 10–30 s mobile cellular.
#   * Morph-aware camera framing in `applyCameraPreset` — FEA mode-shape
#     bundles (which display at morphTargetInfluences=[1] on load) no
#     longer clip the cantilever tip against the viewer's bottom edge.
#     Live framing now matches the offscreen poster's framing pose.
#   * Camera re-fits AFTER `onReady` so FEA-session activation (which
#     writes the [1.0] morph influence) is in scope when the bbox is
#     computed — the previous attempt had the timing inverted.
#   * Interactive3DFigure viewerSize auto-measure no longer locks to
#     the poster's placeholder height — the wrapper now grows to
#     match the loaded image so the canvas isn't overflow-clipped at
#     the bottom by its own ``overflow: hidden`` ancestor.
#   * mountViewer skips its 400 px min-height floor when the host has
#     an explicit ``style.height`` — fixes mobile clipping where the
#     poster-sized wrapper (~322 px) was shorter than the floor.
#   * ThreeDRenderer outer wrapper now ``h-full`` so the wrapper's
#     explicit pixel height (set by Interactive3DFigure to match the
#     poster) propagates down to the mountViewer host without
#     collapsing through an ``auto``-height intermediate div.
# ---- Report-viewer overlay (opt-in: --build-arg VIEWER_OVERLAY=1) ----------------------------------
# The FEA report's 3D figures are paradoc's vendored copy of adapy's WebGPU embed. Without the overlay
# they are whatever the locked conda-forge paradoc shipped; with it, the embed is built from THIS adapy
# source (and adacpp's renderer from ADACPP_RENDER_REF), vendored into paradoc at PARADOC_REF, and that
# paradoc replaces the env's -- an embed or paradoc change reaches the report in one docs build, not
# after a paradoc release and a conda-forge round. Off (the default) both stages are no-ops.
FROM emscripten/emsdk:6.0.11 AS overlay-render
ARG VIEWER_OVERLAY=0
# Keep in step with Dockerfile.viewer's ADACPP_RENDER_REF.
ARG ADACPP_RENDER_REF=6eece0d7e6a47922f692e84ce1e940e38ccf3f6d
ARG ADACPP_GIT_URL=https://github.com/Krande/adacpp.git
RUN mkdir -p /out && if [ "$VIEWER_OVERLAY" = "1" ]; then \
      git init -q /src && cd /src \
      && git remote add origin "$ADACPP_GIT_URL" \
      && git fetch -q --depth 1 origin "$ADACPP_RENDER_REF" \
      && git checkout -q FETCH_HEAD \
      && bash tools/build_render_wasm.sh /out \
      && git rev-parse HEAD > /out/adacpp_render.ref; \
    fi

FROM node:24 AS overlay-paradoc
ARG VIEWER_OVERLAY=0
ARG PARADOC_REF=main
ARG PARADOC_GIT_URL=https://github.com/Krande/paradoc.git
WORKDIR /build/adapy-frontend
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN if [ "$VIEWER_OVERLAY" = "1" ]; then npm ci; fi
COPY src/frontend/ ./
COPY --from=overlay-render /out/ /render/
# /out/paradoc: the paradoc package (its frontend.zip rebuilt around this embed), or nothing.
RUN mkdir -p /out && if [ "$VIEWER_OVERLAY" = "1" ]; then \
      ADACPP_RENDER_DIR=/render npm run build:embed-webgpu \
      && git init -q /paradoc && cd /paradoc \
      && git remote add origin "$PARADOC_GIT_URL" \
      && git fetch -q --depth 1 origin "$PARADOC_REF" \
      && git checkout -q FETCH_HEAD \
      && cp /build/adapy-frontend/dist-embed-webgpu/index.js /build/adapy-frontend/dist-embed-webgpu/index.d.ts \
            src/frontend/vendor/ada-viewer/ \
      && printf 'adapy: docs build overlay\nadacpp renderer: %s\n' "$(cat /render/adacpp_render.ref)" \
            > src/frontend/vendor/ada-viewer/SOURCE \
      && cd src/frontend && npm ci && npm run build:standalone \
      && cp -r /paradoc/src/paradoc /out/paradoc \
      && echo "paradoc $(git -C /paradoc rev-parse --short HEAD) + adapy embed overlay" > /out/paradoc/OVERLAY; \
    fi

# The notebooks and mkdocstrings import ``ada`` at build time, so src/
# must be present. verification/ is needed by the fea-doc task that the
# `docs` pixi task depends on. The .git directory is intentionally NOT
# copied — every commit appends to it, so `COPY .git/` would invalidate
# this layer (and every layer below) on every CI run, defeating the
# per-directory cache granularity. The workflow runs `git describe` /
# `git show` in the host checkout and passes ADA_DOCS_RELEASE /
# ADA_DOCS_DATE as build args wired into ENV below (the Sphinx footer
# used them; the Zensical theme shows the latest GitHub release instead,
# so nothing renders them at the moment).
# Source + doc-generation stage on top of the env base. Dockerfile.docs-fast
# mirrors everything from here down, FROM the published docs-env base.
FROM docs-env AS builder
ARG ADA_DOCS_RELEASE=""
ARG ADA_DOCS_DATE=""
# adapy runs off PYTHONPATH here, so it has no distribution metadata to read its version from;
# CI passes scripts/packaging/adapy_version.sh's answer so the report stamps it (#464).
ARG ADAPY_VERSION=""
ENV ADA_DOCS_RELEASE=$ADA_DOCS_RELEASE \
    ADA_DOCS_DATE=$ADA_DOCS_DATE \
    ADAPY_VERSION=$ADAPY_VERSION
COPY src/ ./src/
COPY docs/ ./docs/
COPY verification/ ./verification/
COPY zensical.toml ./
COPY scripts/docs/docs_notebooks.py ./scripts/docs/
# Included into the procedural-modelling page and rendered as its 3D figure.
COPY examples/penetration_detail.py ./examples/
COPY examples/mesh_overrides.py ./examples/

# The report-viewer overlay (VIEWER_OVERLAY=1): its paradoc over the env's, before fea-doc runs.
COPY --from=overlay-paradoc /out/ /overlay/
RUN if [ -d /overlay/paradoc ]; then \
      dest="$(pixi run --environment docs python -c 'import os, paradoc; print(os.path.dirname(paradoc.__file__))')" \
      && rm -rf "$dest" && cp -r /overlay/paradoc "$dest" \
      && echo "overlay: $(cat "$dest/OVERLAY")"; \
    fi

# The FEA verification report (docs/_static/fea-report/) and its DOCX / ODT / PDF exports
# (docs/_static/fea-report-files/), then the notebooks and zensical into site/. The report is kept
# in a cache mount under a hash of its inputs and reused while they are unchanged, with the current
# viewer frontend (scripts/docs/fea_report_cached.py). Where the mount does not persist it is simply
# built. A failed export leaves a dead download link but does not stop the site. The rattler cache
# mount covers a solve these tasks might trigger.
COPY scripts/docs/fea_report_cached.py ./scripts/docs/
RUN --mount=type=cache,target=/root/.cache/rattler,sharing=locked \
    --mount=type=cache,id=adapy-fea-report,target=/cache/fea-report,sharing=locked \
    pixi run --environment docs python scripts/docs/fea_report_cached.py --cache /cache/fea-report \
        --frontend-zip /overlay/paradoc/frontend/resources/frontend.zip \
    && pixi run --environment docs docs-site

FROM nginxinc/nginx-unprivileged:1.27-alpine
ARG IMAGE_TAG
LABEL org.opencontainers.image.title="ada-docs" \
      org.opencontainers.image.version="${IMAGE_TAG}"

# Custom default.conf with gzip on (`text/*`, `application/json`,
# `application/octet-stream`, `model/gltf-binary`) so the FEA bundle's
# multi-MB index.html and per-(case, mode) GLBs are wire-compressed.
COPY deploy/nginx-docs.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /work/adapy/site/ /usr/share/nginx/html/

EXPOSE 8080
