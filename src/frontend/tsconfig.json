{
  "compilerOptions": {
    "rootDirs": ["./src"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@adapy-plugins/demo": ["packages/plugins/demo/src/register.tsx"]
    },
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "WebWorker"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "moduleResolution": "Node",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react"
  },
  "include": ["src/**/*.*", "packages/plugins/**/*.*"],
  "exclude": ["node_modules"]
}
