namespace commands;

enum CommandType : byte {
  PING = 0,
  PONG = 1,
  UPDATE_SCENE = 2,
  UPDATE_SERVER = 3,
  MESH_INFO_CALLBACK = 4,
  MESH_INFO_REPLY = 5,
  LIST_WEB_CLIENTS = 6,
  LIST_FILE_OBJECTS = 7,
  LIST_PROCEDURES = 8,
  RUN_PROCEDURE = 9,
  ERROR = 10,
  SERVER_REPLY = 11,
  VIEW_FILE_OBJECT = 12,
  DELETE_FILE_OBJECT = 13,
  START_NEW_NODE_EDITOR = 14,
  START_FILE_IN_LOCAL_APP = 15,
  GET_SERVER_INFO = 18,
  SHUTDOWN_SERVER = 19,
  // 16 and 17 are retired values; do not reuse them (see commands.fbs history).
  // Save a procedural model's document to local disk. The reply rides the
  // generic SERVER_REPLY (server_reply.reply_to == SAVE_PROCEDURAL_MODEL),
  // same convention as every other verb here.
  SAVE_PROCEDURAL_MODEL = 20,
  // Step 6: the local-disk model browser. LIST_PROCEDURAL_MODELS enumerates
  // what SAVE_PROCEDURAL_MODEL has written under the model directory;
  // LOAD_PROCEDURAL_MODEL reads one of them back by model_id. Both reply
  // over the generic SERVER_REPLY, same convention as SAVE_PROCEDURAL_MODEL.
  LIST_PROCEDURAL_MODELS = 21,
  LOAD_PROCEDURAL_MODEL = 22,
  // FEA results streamed to the viewer the way the REST viewer reads them: a
  // bake (manifest + mesh GLB + per-field blobs) the browser fetches piece by
  // piece, instead of one GLB carrying every step. REGISTER_FEA_SOURCE (local
  // -> server) names a bake directory on this machine under a source key and
  // asks the server to tell the viewers; OPEN_FEA_SOURCE is that push (server
  // -> web). GET_FEA_MANIFEST and GET_FEA_BLOB (web -> server) read the bake;
  // all three requests reply over SERVER_REPLY like every other verb.
  REGISTER_FEA_SOURCE = 23,
  OPEN_FEA_SOURCE = 24,
  GET_FEA_MANIFEST = 25,
  GET_FEA_BLOB = 26,
  // Run one of the server's whitelisted compute kernels -- the adacpp functions the
  // browser viewer runs as WebAssembly -- in the server's Python process. Lets the
  // websocket viewer (no /wasm to load from file://) do the same work. Replies over
  // SERVER_REPLY like every other verb.
  CALL_KERNEL = 27,
}

enum TargetType : byte {
  WEB = 0,
  LOCAL = 1,
  SERVER = 2,
}

table WebClient {
  instance_id: int;
  name: string;
  address: string;
  port: int;
  last_heartbeat: long;
}