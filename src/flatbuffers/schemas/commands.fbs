namespace commands;

enum CommandType : byte {
  PING = 0,
  PONG = 1,
  UPDATE_SCENE = 2,
  UPDATE_SERVER = 3,
  MESH_INFO_CALLBACK = 4,
  MESH_INFO_REPLY = 5,
  LIST_WEB_CLIENTS = 6,
  LIST_FILE_OBJECTS = 7,
  LIST_PROCEDURES = 8,
  RUN_PROCEDURE = 9,
  ERROR = 10,
  SERVER_REPLY = 11,
  VIEW_FILE_OBJECT = 12,
  DELETE_FILE_OBJECT = 13,
  START_NEW_NODE_EDITOR = 14,
  START_FILE_IN_LOCAL_APP = 15,
  GET_SERVER_INFO = 18,
  SHUTDOWN_SERVER = 19,
  // 16 and 17 are retired values; do not reuse them (see commands.fbs history).
  // Websocket/REST parity plan (docs/documents/ws_rest_parity.rst), step 3:
  // save a procedural model's document to local disk. The reply rides the
  // generic SERVER_REPLY (server_reply.reply_to == SAVE_PROCEDURAL_MODEL),
  // same convention as every other verb here.
  SAVE_PROCEDURAL_MODEL = 20,
  // Step 6: the local-disk model browser. LIST_PROCEDURAL_MODELS enumerates
  // what SAVE_PROCEDURAL_MODEL has written under the model directory;
  // LOAD_PROCEDURAL_MODEL reads one of them back by model_id. Both reply
  // over the generic SERVER_REPLY, same convention as SAVE_PROCEDURAL_MODEL.
  LIST_PROCEDURAL_MODELS = 21,
  LOAD_PROCEDURAL_MODEL = 22,
}

enum TargetType : byte {
  WEB = 0,
  LOCAL = 1,
  SERVER = 2,
}

table WebClient {
  instance_id: int;
  name: string;
  address: string;
  port: int;
  last_heartbeat: long;
}