# syntax=docker/dockerfile:1.7

# Stage 0: pull the prebuilt adacpp pyodide wheel from the base image
# adacpp publishes on tag (ghcr.io/krande/adacpp-wasm-base:<ver>). The
# base image carries
# /out/ada_cpp-<ver>-cp313-cp313-pyodide_2025_0_wasm32.whl plus
# /out/manifest.json — exactly what this stage consumes. adapy no
# longer cross-compiles OCCT→wasm itself; that ~30-min build lives in
# adacpp's own publish-wasm-base workflow and runs only on adacpp
# releases.
#
# THIS LINE IS THE PIN — the single source of the adacpp wasm base version.
# Both CI systems derive it from here (github publish-image.yaml lets this
# default stand; forgejo build.yaml seds it out to pre-pull); override the
# build-arg only to point at a different registry/tag.
#
# It did not used to be. Both workflows restated the version as their own
# literal with a "keep in sync with deploy/Dockerfile.viewer" comment, and both
# drifted to 0.13.2 while this line said 0.14.0 — and since a passed build-arg
# overrides an ARG default, THEIR value is what shipped. Bumping this line alone
# changed nothing about the built image. Hence: derived, not restated.
#
# MUST stay >=0.9.0 — older bases ship an emscripten 3.1.58 wheel that micropip
# refuses against pyodide 0.29.4 ("Wheel was built with Emscripten v3.1.58 but
# Pyodide was built with v4.0.9").
#
# MUST also stay >=0.25.0 — that is where adacpp started shipping the
# adacpp_extrude embind module, which the frontend fetches at runtime to expand
# compact beam solids in the browser. A base without it builds perfectly green
# and ships a viewer that draws every beam as a line; the guard after the /wasm/
# promotion below turns that into a build failure instead.
#
# 0.30.1 carries the joint-member ordering fix (adacpp#68). The browser builds
# its type KEYS inside the wasm module, and a joint of three or more members is
# typed from the angle between its first two -- so a base without the fix types
# such a joint differently from the worker, on the same model. A version pin is
# the only thing standing between those two answers.
#
# MUST also stay >=0.30.0 — that is where adacpp_ifc_glb gained `scanMembers`
# and `clashJoints`, the member scan and the in-browser clash check. Those are
# VERBS INSIDE a module that has existed since 0.25, so the file-existence guard
# below cannot see their absence: an older base ships an adacpp_ifc_glb.js that
# is present, loads, converts — and answers `undefined` the moment the Clashes
# panel asks it for a check. The guard therefore greps the .wasm for the verbs
# as well as the files.
#
# KEEP IN STEP WITH `ada-cpp` in pixi.toml, so the module running in the browser
# and the package in the conda envs are the same adacpp release. They drifted
# once already (this said 0.25.3 while pixi.toml had moved to 0.29), which is
# survivable only until the browser needs a verb the older base lacks.
ARG ADACPP_BASE_IMAGE=ghcr.io/krande/adacpp-wasm-base:0.30.1
FROM ${ADACPP_BASE_IMAGE} AS adacpp-wheel

# Stage 0b: build the pure-python adapy wheel for pyodide. The browser
# FEM/SAT stacks micropip-install this; it's the adapy source tree shipped
# verbatim — the real ada/__init__.py loads under pyodide (its module-level
# deps are only numpy/pyquaternion/trimesh; CAD/FEM kernels are lazy).
# Stdlib-only build script — no setuptools/build needed. Outputs the wheel +
# adapy-manifest.json to /out.
FROM python:3.12-slim AS adapy-wheel
WORKDIR /repo
COPY src/ada/ ./src/ada/
COPY tools/build_pyodide_adapy_wheel.py ./tools/build_pyodide_adapy_wheel.py
RUN python tools/build_pyodide_adapy_wheel.py /out

# Stage 1: build the SPA bundle.
FROM node:20-slim AS frontend-build
WORKDIR /build
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci
COPY src/frontend/ ./

# Optional external-plugin overlay — GENERIC, names no plugin here. Any extra
# plugin package(s) are expected to already sit under packages/plugins/ in the
# build context (the CI pre-clones them there, keeping the clone credential in the
# workflow rather than the image). EXTRA_PLUGINS_ENABLE (→ ADA_PLUGINS_EXTRA, read
# by gen:plugins below) lists the package names to register. Unset → the overlay is
# a no-op and the build is identical to a plain viewer build. The external-plugin↔
# adapy link lives only in the CI config, never in this repo.
ARG EXTRA_PLUGINS_ENABLE=""
ENV ADA_PLUGINS_EXTRA=${EXTRA_PLUGINS_ENABLE}

# Which UI this image boots into. A plugin may contribute a whole alternative
# viewer UI (a "UI shell" — src/frontend/src/plugins/uiShells.ts); the UI it
# defaults to is a property of the BUILD, not of adapy source. Unset => the
# built-in `core` UI, i.e. an unchanged build. Set it to a shell id contributed by
# one of the overlaid packages above to ship that UI as the default; `?ui=core`
# still reaches the built-in one, and the switcher in the menu bar appears as soon
# as a second shell is registered. Like EXTRA_PLUGINS_ENABLE, the value lives in
# the CI config — never in this repo.
#
# This bakes the default into the image. A hosted deployment can instead set
# ADA_VIEWER_UI_DEFAULT on the API pod (chart value `ui.default`), which the
# server serves to the browser via /config.js and which outranks this — so one
# image can serve deployments that want different UIs. Prefer that unless the
# image is meant to be a one-UI artefact. EXTRA_PLUGINS_ENABLE has no runtime
# equivalent: it decides what the image actually contains.
ARG UI_DEFAULT=""
ENV ADA_UI_DEFAULT=${UI_DEFAULT}

# Regenerate the build-time plugin registry (picks up ADA_PLUGINS_EXTRA and
# ADA_UI_DEFAULT above). No-op-equivalent when unset — reproduces the committed
# registry from plugins.json.
RUN npm run gen:plugins

# `build:serve` uses vite.config.serve.ts — split chunks (three/react/flow)
# without the embed-script inlining step (that's reserved for `build`,
# which produces the singlefile bundle baked into the Python package).
RUN npm run build:serve

# After Vite produces dist/, layer in the static assets the pyodide
# worker fetches at runtime under /wheels/: the adacpp wasm wheel (+ its
# manifest.json) and the pure-python adapy wheel (+ adapy-manifest.json).
# Both /out/ trees have distinct filenames, so they coexist in one dir.
# The worker micropip-installs the adapy wheel (deps=False) instead of the
# old hand-mounted source closure.
COPY --from=adacpp-wheel /out/ /build/dist/wheels/
COPY --from=adapy-wheel  /out/ /build/dist/wheels/

# The no-pyodide embind modules (adacpp_step_glb / adacpp_ifc_glb / adacpp_brep_writer /
# adacpp_glb_diff / adacpp_extrude .js + .wasm) ship in the same adacpp base image under /out/wasm/,
# so the copy above lands them at dist/wheels/wasm/. Promote the whole dir to /wasm/ — where the
# in-browser converters (cadGlbConverter / brepWriterConverter workers), the diff utility and the
# compact beam-solid expander fetch them. Globbed, so a base that ships extra modules needs no edit.
RUN mkdir -p /build/dist/wasm && \
    if [ -d /build/dist/wheels/wasm ]; then \
        mv /build/dist/wheels/wasm/* /build/dist/wasm/ && rmdir /build/dist/wheels/wasm; \
    fi

# ...and then fail the build if any module the frontend fetches is missing. These are loaded at
# RUNTIME from /wasm/<name>.js and never bundled, so the SPA build above cannot notice their absence:
# an ADACPP_BASE_IMAGE that predates one of them builds green all the way to a pushed image, and the
# browser merely console.warns and degrades in silence. That is how the pin sat at a base without
# adacpp_extrude while the viewer drew every compact-baked beam as a line.
# Keep the list in step with `grep -rn '/wasm/adacpp_' src/frontend/src`.
RUN set -eu; \
    for m in adacpp_step_glb adacpp_ifc_glb adacpp_brep_writer adacpp_glb_diff adacpp_extrude; do \
        for f in "/build/dist/wasm/$m.js" "/build/dist/wasm/$m.wasm"; do \
            [ -f "$f" ] && continue; \
            echo "ERROR: $f is missing — the adacpp wasm base image (ADACPP_BASE_IMAGE, see the" >&2; \
            echo "       pin at the top of this file) does not ship $m, which the frontend fetches" >&2; \
            echo "       from /wasm/ at runtime. Bump the pin to an adacpp release that has it." >&2; \
            exit 1; \
        done; \
    done

# A module can be PRESENT and still lack the verb the frontend calls on it. `scanMembers` and
# `clashJoints` were added to adacpp_ifc_glb in 0.30, to a module that has shipped since 0.25 — so
# the loop above passes on an older base and the Clashes panel then calls `undefined` in a browser
# nobody is watching. embind writes each exported name into the .wasm as a literal, so grepping for
# it is enough to tell a base that HAS the verb from one that merely has the module.
# Keep in step with the verbs called in `src/frontend/src/utils/nativeConvert/*.worker.ts`.
RUN set -eu; \
    for v in scanMembers clashJoints ifcToGlb; do \
        grep -aq "$v" /build/dist/wasm/adacpp_ifc_glb.wasm && continue; \
        echo "ERROR: adacpp_ifc_glb.wasm does not export $v — the adacpp wasm base image" >&2; \
        echo "       (ADACPP_BASE_IMAGE, see the pin at the top of this file) predates it." >&2; \
        echo "       The module loads and the verb answers undefined at runtime. Bump the pin." >&2; \
        exit 1; \
    done

# Stage 2a: pixi env solver — installs the viewer-api-slim environment
# from pixi.toml/pixi.lock so the runtime stack stays in lockstep with
# what's solved locally. Replaces a hand-curated ``pip install`` list
# that drifted from the rest of the project's dep management and
# couldn't share a lockfile.
FROM ghcr.io/prefix-dev/pixi:0.68.0 AS env-builder
WORKDIR /work
COPY pixi.toml pixi.lock pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/rattler,sharing=locked \
    pixi install --environment viewer-api-slim --locked

# Stage 2b: runtime — copy the resolved env into a slim base and run
# its python directly. The env is self-contained (conda-managed glibc,
# python, deps), so no pixi binary needed at runtime.
FROM debian:bookworm-slim AS runtime
ARG IMAGE_TAG=dev
# WHICH ADAPY THIS IS, which nothing else in the image can answer.
#
# IMAGE_TAG is set by whatever assembles the image, and for a composed
# deployment that is the assembling repo's commit, not adapy's. The version the
# viewer reports is stamped from adapy's last RELEASE TAG. So an image built
# from a branch cut off `v0.64.1` with no version bump reports `0.64.1` and the
# assembler's commit -- character for character what an image built from the
# release tag reports. Which one is actually deployed then exists nowhere in
# the running system, only in the inputs of whichever CI run produced it.
#
# Empty by default: a local `docker build` that was not told anything says
# nothing, rather than claiming a ref it cannot know.
ARG ADAPY_REF=""
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ADA_IMAGE_TAG=${IMAGE_TAG} \
    ADA_ADAPY_REF=${ADAPY_REF}
WORKDIR /app

COPY --from=env-builder /work/.pixi/envs/viewer-api-slim /env
ENV PATH="/env/bin:$PATH"
# conda's openssl bakes its CA path (OPENSSLDIR) to the absolute build
# prefix (/work/.pixi/envs/viewer-api-slim/ssl), which no longer exists
# after the env is COPY'd to /env. urllib (used by PyJWKClient for the
# JWKS fetch) honours OpenSSL's default path, so without this it can't
# verify TLS to the configured Authentik (OIDC) host and every token check 401s — while
# httpx-based discovery still works via certifi, hence callback-OK but
# /api/me-401. Point OpenSSL/urllib at the CA bundle in its new location.
ENV SSL_CERT_FILE=/env/ssl/cert.pem \
    SSL_CERT_DIR=/env/ssl/certs

COPY deploy/viewer-ada-init.py /app/src/ada/__init__.py
COPY src/ada/config.py /app/src/ada/config.py
COPY src/ada/comms/ /app/src/ada/comms/
# ada.cad — the tessellation-track registry. ada.comms.rest.converter imports it at MODULE level
# (the published step_glb_pipeline/tessellator vocabulary is discovered, not listed), so leaving it
# out crashlooped the API on startup. Safe to ship into the slim runtime: ada/cad/registry.py is
# stdlib-only by construction and ada/cad/__init__ keeps numpy/OCC behind function-local imports and
# a lazy __getattr__, so nothing native is dragged in. With no adacpp installed here, discovery
# correctly reports no tracks and the API publishes the static vocabulary — the adacpp tracks reach
# the dropdown from the pools that actually run them, via each worker's advertised enum.
COPY src/ada/cad/ /app/src/ada/cad/
# ada.assets — the core asset store's storage half. ada.comms.rest.app imports routes/assets.py at
# MODULE level (it is an include_router at startup like every other router), so leaving it out
# crashlooped the slim API on `No module named 'ada.assets'` exactly the way ada.cad did above.
# Safe to ship on the same test: the whole package is stdlib-only by construction -- json, re,
# dataclasses, datetime, threading and typing, plus its own submodules. It reads and writes blobs
# core owns the schema for and never opens a provider's source artefact, so nothing native or
# format-specific is dragged in.
COPY src/ada/assets/ /app/src/ada/assets/
# ada.clash -- the Clashes surface's schema half. ada.comms.rest.app includes routes/clash_check.py
# at MODULE level like every other router, so leaving it out crashloops the slim API on
# `No module named 'ada.clash'` exactly as ada.cad and ada.assets did above. Safe on the same
# test, and deliberately built to pass it: the package's __init__ resolves names LAZILY, and the
# two modules the API actually touches (`options`, `result`, `builtin_names`) are stdlib-only.
# Identification itself -- ada.api beams/plates, numpy, a reader -- is imported only by
# `identify`/`classify`/`match`/`builtin_specs`, which run on a WORKER and are never imported here.
COPY src/ada/clash/ /app/src/ada/clash/
# ada.core.file_system — ada.comms.rest.{app,converter} import new_temp_path at MODULE level, so
# without this the API crashloops on `No module named 'ada.core'` exactly the way it did on
# `ada.cad` above. Only the one module ships, not the package: the rest of ada/core is numpy-bound
# (vector_transforms, curve_utils, ...) and has no business in the slim runtime. file_system.py
# itself is stdlib + ada.config only. ada/core/__init__.py is empty upstream, so it is copied as-is
# rather than stubbed the way ada.sections has to be.
COPY src/ada/core/__init__.py /app/src/ada/core/__init__.py
COPY src/ada/core/file_system.py /app/src/ada/core/file_system.py
# ada.core.{text_utils,catalog_docs,xlsx_meta} — the slug helper, the equipment/system doc
# validators and the _ADA_META sheet reader that ada.comms.rest.{catalog,procedural} re-export.
# Stdlib + pydantic only, like file_system.py above: they moved here so the CAD readers and the
# procedural engines stop importing from ada.comms.
COPY src/ada/core/text_utils.py /app/src/ada/core/text_utils.py
COPY src/ada/core/catalog_docs.py /app/src/ada/core/catalog_docs.py
COPY src/ada/core/xlsx_meta.py /app/src/ada/core/xlsx_meta.py
# ada.core.engine_specs — the is_offerable predicate ada.comms.engine_specs
# re-exports (imported at MODULE level by ada.comms.rest.routes.deps). Stdlib
# only, like the others above: it lives below both ada.comms and
# ada.topo_model so neither has to import the other for it.
COPY src/ada/core/engine_specs.py /app/src/ada/core/engine_specs.py
# ada.plugins — the backend-plugin registry. Unlike the two above its absence does not crashloop
# anything: the API imports it defensively and logs "ada.plugins discovery failed (non-fatal)". But
# it logged that with a traceback on EVERY boot, for a module that was never shipped rather than one
# that broke — so the loudest recurring line in the API's log described a deliberate omission.
#
# It also left a real gap. _locally_registered_spec (see app.py) resolves the plugin-job admin
# declaration for a single-node viewer that preloads a plugin INTO the API, where no worker
# advertises it and the registry is the only source there is. Without this module that source can
# never answer, so the gate silently ran on fewer inputs than it was written for.
#
# Safe to ship, on the same test ada/cad passes above: ada/plugins/__init__.py and the whole
# external_models subtree are stdlib-only (logging, typing, dataclasses, os, datetime,
# importlib.metadata) — nothing numpy- or OCC-bound. With no plugin distribution installed in the
# slim env, discovery correctly finds no entry points and registers nothing.
COPY src/ada/plugins/ /app/src/ada/plugins/
# pyproject.toml is the single source of truth for the version. The viewer copies adapy source
# (no installed-dist metadata) and a stripped ada/__init__ (no __version__), so config.js reads
# the version from here for window.ADAPY_VERSION (see _resolve_adapy_version).
COPY pyproject.toml /app/pyproject.toml

# ada.sections subset — required by /api/components/profiles. Only the
# stdlib-only files (categories + profile_lookup + the ProfileDB.json
# resource) ship here; the package __init__ that imports Section /
# GeneralProperties (numpy-dependent) is replaced with a slim stub
# below so importing ada.sections.profile_lookup doesn't drag the
# whole CAD stack into the viewer image.
COPY src/ada/sections/categories.py        /app/src/ada/sections/categories.py
COPY src/ada/sections/profile_lookup.py    /app/src/ada/sections/profile_lookup.py
COPY src/ada/sections/resources/ProfileDB.json /app/src/ada/sections/resources/ProfileDB.json
RUN printf '%s\n' \
    '"""Slim shim — see deploy/Dockerfile.viewer for context."""' \
    'from .categories import SectionCat' \
    '' \
    '__all__ = ["SectionCat"]' \
    > /app/src/ada/sections/__init__.py

# Static SPA bundle from the first stage.
COPY --from=frontend-build /build/dist /app/static

ENV PYTHONPATH=/app/src \
    ADA_VIEWER_HOST=0.0.0.0 \
    ADA_VIEWER_PORT=8080 \
    ADA_VIEWER_STATIC_PATH=/app/static \
    ADA_VIEWER_STORAGE_KIND=local \
    ADA_VIEWER_LOCAL_PATH=/data

EXPOSE 8080

# Healthcheck hits the API liveness endpoint.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2).status == 200 else 1)"

CMD ["python", "-m", "ada.comms.rest"]

# (build trigger: external-plugin overlay vars now configured in CI)

# (rebuild: pick up updated capacity plugin — 3D scene interactions)
